{
  "name": "duoduo-desktop-pet",
  "version": "1.0.0",
  "description": "独立运行的多多桌面宠物",
  "main": "main.js",
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.duoduo.desktop-pet",
    "productName": "多多桌宠",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "pet.json",
      "spritesheet.webp"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
